    {
      "datasource": {
        "type": "prometheus",
        "uid": "$PROMETHEUS_DS"
      },
      "description": "Share of the hub-db-dir disk (the JupyterHub sqlite database) currently used, for the 10 fullest hubs selected in the Hub selector. If a disk fills up, that hub stops working.\n\nThese disks are mostly far from full and grow by a few MiB a month, so this is a current-value ranking rather than a graph over time. Orange at 90% and red at 95% match the Hub DB disk alert rules.\n",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 1,
          "min": 0,
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "id": 8,
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "minVizHeight": 10,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "sort_desc(topk(10,\n  max by (namespace) (kubelet_volume_stats_used_bytes{persistentvolumeclaim=\"hub-db-dir\", namespace=~\"$hub\"})\n  / max by (namespace) (kubelet_volume_stats_capacity_bytes{persistentvolumeclaim=\"hub-db-dir\", namespace=~\"$hub\"})\n))\n",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "title": "Hub DB disk used (10 fullest hubs)",
      "type": "bargauge"
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Core pool cluster utilization",
      "description": "Share of the core node pool (where hub, proxy and other support pods run) taken by CPU requests, memory requests and pod count.\n",
      "datasource": {
        "type": "prometheus",
        "uid": "$PROMETHEUS_DS"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"} * on (node) group_left() group by (node) (kube_node_labels{label_hub_jupyter_org_pool_name=~\"core-pool.*\"}))\n/ sum(kube_node_status_allocatable{resource=\"cpu\"} * on (node) group_left() group by (node) (kube_node_labels{label_hub_jupyter_org_pool_name=~\"core-pool.*\"}))",
          "legendFormat": "CPU requests",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "sum(kube_pod_info * on (node) group_left() group by (node) (kube_node_labels{label_hub_jupyter_org_pool_name=~\"core-pool.*\"}))\n/ sum(kube_node_status_allocatable{resource=\"pods\"} * on (node) group_left() group by (node) (kube_node_labels{label_hub_jupyter_org_pool_name=~\"core-pool.*\"}))",
          "legendFormat": "Pod Count",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\"} * on (node) group_left() group by (node) (kube_node_labels{label_hub_jupyter_org_pool_name=~\"core-pool.*\"}))\n/ sum(kube_node_status_allocatable{resource=\"memory\"} * on (node) group_left() group by (node) (kube_node_labels{label_hub_jupyter_org_pool_name=~\"core-pool.*\"}))",
          "legendFormat": "Memory requests",
          "refId": "D"
        }
      ]
    },
