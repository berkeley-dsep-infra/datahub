        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$hub\", pod=~\"hub-.*\", container=\"hub\"}) by (namespace)",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
