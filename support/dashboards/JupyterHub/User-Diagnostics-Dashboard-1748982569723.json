      "options": {
        "sortBy": [
          {
            "desc": true,
            "displayName": "Peak CPU (cores)"
          }
        ]
      },
      "pluginVersion": "v10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "max by (namespace, pod) (\n  max_over_time(jupyterhub:user_pod_cpu_usage_cores:rate5m{namespace=~\"$hub\", pod=~\"$user_pod\"}[$__range])\n) > 0.5\n",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "User Pods with high CPU usage (>0.5)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "Value": 2
            },
            "renameByName": {
              "namespace": "Hub",
              "pod": "User pod",
              "Value": "Peak CPU (cores)"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "description": "User pods whose memory use reached more than 80% of their memory limit at any point in the selected time range, with the peak share. Once they hit their memory limit, user kernels will start dying. Filter by hub with the Hub selector or the Hub column.\n",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percentunit",
          "custom": {
            "filterable": true
          }
        },
