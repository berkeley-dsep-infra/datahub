      "options": {
        "sortBy": [
          {
            "desc": true,
            "displayName": "Peak % of memory limit"
          }
        ]
      },
      "pluginVersion": "v10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "max by (namespace, pod) (\n  max_over_time(jupyterhub:user_pod_memory_working_set_bytes:sum{namespace=~\"$hub\", pod=~\"$user_pod\"}[$__range])\n)\n/\nsum by (namespace, pod) (\n  max_over_time(kube_pod_container_resource_limits{resource=\"memory\", namespace=~\"$hub\", pod=~\"$user_pod\"}[$__range])\n)\n> 0.8\n",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "User pods with high memory usage (>80% of limit)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "Value": 2
            },
            "renameByName": {
              "namespace": "Hub",
              "pod": "User pod",
              "Value": "Peak % of memory limit"
            }
          }
        }
      ],
      "type": "table"
    },
