      "options": {
        "sortBy": [
          {
            "desc": true,
            "displayName": "Age"
          }
        ]
      },
      "pluginVersion": "v10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "(\n  time() - (kube_pod_created * on (namespace, pod)  \n  group(\n    kube_pod_labels{label_app=\"jupyterhub\", label_component=\"singleuser-server\", namespace=~\"$hub\", pod=~\"$user_pod\"}\n  ) by (label_component, pod, namespace))\n)  > (8 * 60 * 60) # 8 hours is our threshold\n",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Very old user pods",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "Value": 2
            },
            "renameByName": {
              "namespace": "Hub",
              "pod": "User pod",
              "Value": "Age"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
