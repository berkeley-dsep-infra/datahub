      },
      "description": "User pods whose CPU use went above 0.5 cores at any point in the selected time range, with their peak value. Filter by hub with the Hub selector or the Hub column.\n",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "suffix: cores",
          "custom": {
            "filterable": true
