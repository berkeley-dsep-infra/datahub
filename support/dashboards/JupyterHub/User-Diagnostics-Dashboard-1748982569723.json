      },
      "description": "User pods running now that are older than 8 hours. Filter by hub with the Hub selector or the Hub column.\n",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s",
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 22
      },
