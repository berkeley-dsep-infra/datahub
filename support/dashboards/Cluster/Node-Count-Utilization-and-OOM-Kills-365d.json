        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "v10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "1 - (\n  sum(node_memory_MemAvailable_bytes) by (node)\n  /\n  sum(node_memory_MemTotal_bytes) by (node)\n) * on(node) group_left(label_cloud_google_com_gke_nodepool)\ngroup(\n  kube_node_labels{label_cloud_google_com_gke_nodepool=~\"$nodepool\"}\n) by (node, label_cloud_google_com_gke_nodepool)\n",
          "legendFormat": "{{label_cloud_google_com_gke_nodepool}}/{{node}}",
          "refId": "A"
        }
      ],
      "title": "Node Memory Utilization %",
      "type": "timeseries"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Node Load 5 (per core)",
      "description": "5 minute load average divided by core count. Values above 1 mean runnable tasks are waiting for CPU.\n",
      "datasource": {
        "type": "prometheus",
        "uid": "$PROMETHEUS_DS"
      },
      "gridPos": {
