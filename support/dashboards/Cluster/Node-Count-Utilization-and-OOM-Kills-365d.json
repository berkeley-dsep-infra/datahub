          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "node_load5 / on (node) count by (node) (node_cpu_seconds_total{mode=\"idle\"})\n* on (node) group_left(label_cloud_google_com_gke_nodepool) group by (node, label_cloud_google_com_gke_nodepool) (kube_node_labels{label_cloud_google_com_gke_nodepool=~\"$nodepool\"})",
