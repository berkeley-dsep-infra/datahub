    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "description": "Number of nodes in each nodepool in this cluster\n",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0,
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "v10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "# sum up all nodes by nodepool\nsum(\n  # kube_pod_labels comes from\n  # https://github.com/kubernetes/kube-state-metrics, and there is a particular\n  # label (kubernetes_node) that lists the node on which the kube-state-metrics pod\n  # s running! So that's totally irrelevant to these queries, but when a nodepool\n  # is rotated it caused there to exist two metrics with the same node value (which\n  # we care about) but different kubernetes_node values (because kube-state-metrics\n  # was running in a different node, even though we don't care about that). This\n  # group really just drops all labels except the two we care about to\n  # avoid messing things up.\n  group(\n    kube_node_labels{label_cloud_google_com_gke_nodepool=~\"$nodepool\"}\n  ) by (node, label_cloud_google_com_gke_nodepool)\n) by (label_cloud_google_com_gke_nodepool)\n",
          "legendFormat": "{{label_cloud_google_com_gke_nodepool}}",
          "refId": "A"
        }
      ],
      "title": "Node Count",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 4,
      "panels": [],
      "title": "Cluster Health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "description": "Pods in states other than 'Running', per node pool of the node they are scheduled on.\n\nPending pods that have not been scheduled to a node yet are shown as 'unscheduled'.\nUnscheduled placeholder pods are shown separately in grey: they are evicted to make room for users and wait for the autoscaler by design, so long grey bars are normal. Unscheduled user pods are what the 'Pods unschedulable' alert watches.\nFilter with the Node pool and Pod status selectors.\n",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "decimals": 0,
          "min": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^unscheduled placeholder.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#8e8e8e",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 20,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "sum by (label_cloud_google_com_gke_nodepool, phase) (\n  (kube_pod_status_phase{phase!=\"Running\", phase=~\"$status\"} == 1)\n  * on (namespace, pod) group_left(node) max by (namespace, pod, node) (kube_pod_info{node!=\"\"})\n  * on (node) group_left(label_cloud_google_com_gke_nodepool) group by (node, label_cloud_google_com_gke_nodepool) (kube_node_labels{label_cloud_google_com_gke_nodepool=~\"$nodepool\"})\n)\n",
          "legendFormat": "{{label_cloud_google_com_gke_nodepool}} {{phase}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "sum by (phase) (\n  (kube_pod_status_phase{phase!=\"Running\", phase=~\"$status\"} == 1)\n  * on (namespace, pod) group_left() max by (namespace, pod) (kube_pod_info{node=\"\"})\n  unless on (namespace, pod) kube_pod_labels{label_component=~\"placeholder|user-placeholder\"}\n)\n",
          "legendFormat": "unscheduled {{phase}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "sum by (phase) (\n  (kube_pod_status_phase{phase!=\"Running\", phase=~\"$status\"} == 1)\n  * on (namespace, pod) group_left() max by (namespace, pod) (kube_pod_info{node=\"\"})\n  and on (namespace, pod) kube_pod_labels{label_component=~\"placeholder|user-placeholder\"}\n)\n",
          "legendFormat": "unscheduled placeholder {{phase}}",
          "refId": "C"
        }
      ],
      "title": "Pods not in Running state (by node pool)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "description": "Number of Out of Memory (OOM) kills on each node, per time step, stacked by node.\n\nWhen users use up more memory than they are allowed, the notebook kernel they\nwere running usually gets killed and restarted. This graph shows the number of times\nthat happens on any given node, and helps validate that a notebook kernel restart was\nin fact caused by an OOM.\n\nThe legend's Total column is the number of kills on that node over the whole time range.\n",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "decimals": 0,
          "min": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$PROMETHEUS_DS"
          },
          "expr": "clamp_min(node_vmstat_oom_kill - node_vmstat_oom_kill offset $__interval, 0) * on(node) group_left(label_cloud_google_com_gke_nodepool)\ngroup(\n  kube_node_labels{label_cloud_google_com_gke_nodepool=~\"$nodepool\"}\n)\nby(node, label_cloud_google_com_gke_nodepool)\n",
          "legendFormat": "{{label_cloud_google_com_gke_nodepool}}/{{node}}",
          "refId": "A"
        }
      ],
      "title": "Out of Memory Kill Count",
      "type": "timeseries"
    },
